# Database
DATABASE_URL=

# Redis (Upstash)
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Gnani ASR
GNANI_API_KEY=
GNANI_LANGUAGE_CODE=en-IN
GNANI_ASR_TIMEOUT_MS=90000

# LLM (Vercel AI Gateway)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4
AI_GATEWAY_FALLBACK_MODELS=openai/gpt-4o-mini
USE_GATEWAY=true

# App
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
RUN_WORKER=false
SESSION_COOKIE_SECRET=
PORT=3001
MAX_UPLOAD_BYTES=52428800
MAX_AUDIO_DURATION_SECONDS=3600
STALL_THRESHOLD_MS=600000
STALL_SWEEP_INTERVAL_MS=300000

# Worker tuning
TRANSCRIBE_CONCURRENCY=3
CHUNK_TARGET_SECONDS=28
CHUNK_OVERLAP_SECONDS=2
SUMMARIZE_MAP_REDUCE_THRESHOLD=12000
